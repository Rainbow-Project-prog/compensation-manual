# Telegram
TELEGRAM_BOT_TOKEN=
GROUP_CHAT_ID=            # 例: -1001234567890（トピック有効のスーパーグループ）

# Lpro
LPRO_LOGIN_URL=https://（Lproのログインページ）
LPRO_TALK_URL=https://（トーク応対画面のURL）

# 動作設定
POLL_INTERVAL_MS=8000
ONLY_UNREAD=true
BOOTSTRAP_TAIL=5         # 稼働中に初めて現れた顧客の初回配信件数（0=配らない※初回を取りこぼす）
HEADLESS=false           # 初回ログインはfalse推奨。確立後はtrueでも可
USER_DATA_DIR=./.lpro-profile
