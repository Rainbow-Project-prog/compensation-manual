# ─────────────────────────────────────────────────────────────────────────────
# Lpro ⇄ Telegram ブリッジ 設定テンプレート（案件1つ分）
#   既定案件（最初の案件）: このファイルを  .env  にコピー（パッケージルート直下）
#   追加案件:               instances/<案件名>/.env  にコピー（案件名は英数字・-・_ のみ、例: foo）
#                           プロファイル・DB・バックアップは同じフォルダ内に自動で作られる
# 案件ごとに Lpro アカウント・Telegram Bot・Telegram グループをすべて分けること
# ─────────────────────────────────────────────────────────────────────────────

# 案件の表示名（運用通知の先頭 [表示名] とログイン待ち画面のバナーに出る。日本語可。空なら案件名/無印）
INSTANCE_LABEL=

# Telegram（案件ごとに BotFather で別の Bot を作る。同じトークンを2案件で使うと 409 Conflict で交互に落ちる）
TELEGRAM_BOT_TOKEN=

# Lpro ログイン
LPRO_LOGIN_URL=https://（Lproのログインページ 例: https://lpro-pmN.com/manage/）
# /manage が HTTP ベーシック認証（ブラウザ標準のポップアップ）で保護されている場合のみ設定。
# Lpro アプリのログイン（ID/パスワードのWebページ）とは別のポップアップ認証。
LPRO_BASIC_USER=
LPRO_BASIC_PASS=
# この案件の Lpro サイトID（数値）。初回ログイン後のログ「Lpro サイト確認: site_id=NN（表示名）」の NN を記入。
# 設定すると別のアカウントでログインされたとき自動ログアウトして正しいログインを待つ（別案件への誤送信防止）
LPRO_SITE_ID=

# ── 受信箱1: チャット応対（自動応答なし・全部手動）→ この Telegram グループへ ──
# URL と グループID の両方を設定すると有効。少なくとも1つの受信箱を有効にすること。
CHAT_TALK_URL=https://（チャット応対画面のURL 例: .../manage/chat_message?method=frame）
CHAT_GROUP_CHAT_ID=       # npm run chatid で取得した -100...（トピック有効のスーパーグループ）

# ── 受信箱2: ダイレクトトーク応対（自動応答の取りこぼしを拾う）→ 別の Telegram グループへ ──
# 使わないなら両方空でよい。使うなら別グループを作り同じ bot を管理者(トピック管理)で追加。
TALK_TALK_URL=          # 例: .../manage/linechat_message_frame
TALK_GROUP_CHAT_ID=

# 動作設定
POLL_INTERVAL_MS=8000
ONLY_UNREAD=true
BOOTSTRAP_TAIL=5         # 稼働中に初めて現れた顧客の初回配信件数（0=配らない※初回を取りこぼす）
# 自分側（L-Pro 側: 一斉配信・自動応答・PC直返信）の発言の扱い。
#   silent（既定）= トピック内の「追記ブロック」に編集で載せる（編集は未読・通知を発生させない＝鳴る・バッジが増えるのは顧客の発言だけ）
#   notify = 通知付きの通常メッセージで流す / off = 流さない（既読台帳には記録）
MIRROR_SELF=silent
HEADLESS=false           # 初回ログインはfalse推奨。確立後はtrueでも可
# ブラウザプロファイル / DB の置き場（通常は未設定でよい＝案件フォルダ内の .lpro-profile / bridge.db）。
# 相対パスは案件フォルダ基準。
#USER_DATA_DIR=./.lpro-profile
#DB_PATH=./bridge.db
# 日次ティック（💓ハートビート＋DBバックアップ）の時刻と、そのときブラウザを開き直すか
DAILY_TICK_HOUR=9
DAILY_BROWSER_RECYCLE=true
# 💓からブラウザ開き直しまでの遅延（分）。Lpro は毎時0〜7分台に一過性エラーが集中するので、その時間帯を避ける
DAILY_RECYCLE_DELAY_MIN=10
